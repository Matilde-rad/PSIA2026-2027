          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_requests_seconds_count{namespace=\"g2\",container=\"edge\",status=~\"5..\"}[1m])) or vector(0)) / sum(rate(http_server_requests_seconds_count{namespace=\"g2\",container=\"edge\"}[1m]))",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
